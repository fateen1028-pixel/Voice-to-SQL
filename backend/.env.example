# ==============================================================================
# Database Configuration
# ==============================================================================
# Connection URL (Supports PostgreSQL and SQLite)
# PostgreSQL Example: postgresql://username:password@localhost:5432/database_name
# SQLite Example:     sqlite:///./assistant.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ==============================================================================
# LLM (Large Language Model) Configuration
# ==============================================================================
# LLM Provider options: gemini | openai | groq | ollama | mock
LLM_PROVIDER=gemini

# API Key for chosen provider (e.g., your Gemini API key)
LLM_API_KEY=your_gemini_api_key_here

# Model identifier
# Gemini options: gemini-2.5-flash | gemini-1.5-flash | gemini-2.0-flash | gemini-1.5-pro
# OpenAI options: gpt-4o-mini | gpt-4o
# Groq options:   llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash

# HTTP Request Timeout for LLM provider in seconds
LLM_TIMEOUT_SECONDS=12.0

# ==============================================================================
# Speech-To-Text (STT) Configuration
# ==============================================================================
# STT Provider options: local | whisper | openai | mock
STT_PROVIDER=local

# Local faster-whisper configuration (CPU-friendly)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# API Key for Speech-To-Text provider (if using external service)
STT_API_KEY=

# Minimum confidence threshold required for voice transcription (0.0 to 1.0)
STT_CONFIDENCE_THRESHOLD=0.6

# ==============================================================================
# Security & System Policy Settings
# ==============================================================================
# Allow destructive DDL operations like DROP/TRUNCATE (Default: false)
ALLOW_DDL=false

# Default maximum row count for generated SELECT queries
MAX_QUERY_ROWS=500

# Maximum bounded SQL repair retry attempts
MAX_REPAIR_ATTEMPTS=3

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
